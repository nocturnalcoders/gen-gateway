# Copy to .env and fill in.

# Every address the gateway answers on, comma separated. ":80" serves plain HTTP on the
# droplet's IP; with hostnames the gateway switches to HTTPS on its own (each hostname
# needs a DNS A record pointing at the droplet first).
#   SITE_ADDRESS=gen.tolie.space, api.gen.tolie.space, gtw-api-gen.tolie.space, cms.gen.tolie.space
SITE_ADDRESS=:80

# Hostnames from SITE_ADDRESS that serve only the API (space separated). The website's own
# hostname always has the API under /api, so this is for other clients such as the bot.
#   API_HOSTS=api.gen.tolie.space gtw-api-gen.tolie.space
# API_HOSTS=

# Hostname from SITE_ADDRESS that serves the CMS (Strapi).
#   CMS_HOST=cms.gen.tolie.space
# CMS_HOST=

# Host ports the gateway binds. Change them only if something else already uses 80/443.
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Behind a web server that already owns 80/443 on the droplet ----------------
# Publish the gateway on localhost only and let that server forward the hostnames here
# (it keeps doing HTTPS). SITE_ADDRESS stays ":80"; API_HOSTS and CMS_HOST as above.
#   HTTP_PORT=127.0.0.1:8790
#   HTTPS_PORT=127.0.0.1:8791
# and in the host's Caddyfile:
#   gen.tolie.space, api.gen.tolie.space, gtw-api-gen.tolie.space, cms.gen.tolie.space {
#       reverse_proxy 127.0.0.1:8790
#   }
